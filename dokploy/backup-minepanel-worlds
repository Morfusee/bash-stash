#!/usr/bin/env bash

set -euo pipefail

BACKUP="/tmp/minepanel-worlds-$(date +%Y-%m-%d_%H-%M-%S).tar.gz"
MINEPANEL_DATA_DIR="/var/lib/docker/volumes/game-hosting-minepanel-rchbtm_minepanel-servers/_data"
trap 'rm -f "$BACKUP"' EXIT

find "$MINEPANEL_DATA_DIR" -mindepth 2 -maxdepth 2 -type d -name mc-data -printf '%P\0' |
  tar -chzf "$BACKUP" -C "$MINEPANEL_DATA_DIR" --null -T -

rclone copy "$BACKUP" \
  gdrive:Dokploy-Backups/MinePanel/worlds \
  --config "/home/${SUDO_USER:-$USER}/.config/rclone/rclone.conf" \
  --progress
